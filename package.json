{
  "name": "solana-data-sign",
  "version": "1.0.0",
  "description": "Solana Anchor project for signing data from EMQX and storing signatures on-chain",
  "main": "index.js",
  "scripts": {
    "lint:fix": "prettier **/**.ts --write",
    "lint": "prettier **/**.ts --check",
    "test": "yarn run ts-mocha -p ./tsconfig.json -t 1000000 tests/**/*.ts",
    "build:program": "anchor build",
    "deploy:devnet": "anchor deploy --provider.cluster devnet",
    "consumer:dev": "tsx consumer/src/index.ts",
    "consumer:build": "cd consumer && npm run build"
  },
  "keywords": [
    "solana",
    "anchor",
    "emqx",
    "blockchain"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@coral-xyz/anchor": "^0.29.0",
    "@solana/web3.js": "^1.87.6"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "tsx": "^4.7.0",
    "typescript": "^4.3.5"
  }
}
